[server]
headless = true

[browser]
gatherUsageStats = false

[theme]
primaryColor = "#0F766E"
font = "sans serif"

[theme.light]
backgroundColor = "#F3F5F7"
secondaryBackgroundColor = "#FFFFFF"
textColor = "#17212B"

[theme.dark]
backgroundColor = "#0A1118"
secondaryBackgroundColor = "#111A24"
textColor = "#F3F6F8"
